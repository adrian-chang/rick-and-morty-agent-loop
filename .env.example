# Set the key for the provider you want. That's the whole config -- the key you
# set is the provider you get: ANTHROPIC_API_KEY means Claude, OPENAI_API_KEY
# means OpenAI, OPENROUTER_API_KEY means OpenRouter.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Both optional. PROVIDER only matters if you set more than one key above and
# want to say which wins; MODEL runs a different model on whichever provider
# ends up chosen. There are no command-line flags -- this file is the config.
PROVIDER=
MODEL=
